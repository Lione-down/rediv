REVID_APP_NAME=Revid API
REVID_CORS_ORIGINS=["http://localhost:5173","http://localhost:9099"]
REVID_JWT_SECRET=change-this-secret-in-production

# === Database ===
# Set to false to use MySQL instead of SQLite
REVID_USE_SQLITE=true
REVID_DB_PATH=revid.db

# MySQL configuration (used when REVID_USE_SQLITE=false)
REVID_DB_HOST=localhost
REVID_DB_PORT=3306
REVID_DB_NAME=revid_db
REVID_DB_USER=root
REVID_DB_PASSWORD=
# Connection pool recycle time in seconds
REVID_DB_POOL_RECYCLE=3600

# === Agnes AI API ===
REVID_AGNES_API_KEY=
REVID_AGNES_BASE_URL=https://apihub.agnes-ai.com
REVID_AGNES_MODEL_TEXT=agnes-2.0-flash
REVID_AGNES_MODEL_IMAGE=agnes-image-2.1-flash
REVID_AGNES_MODEL_VIDEO=agnes-video-v2.0

# === WeChat OAuth ===
REVID_WECHAT_APP_ID=
REVID_WECHAT_APP_SECRET=
REVID_WECHAT_REDIRECT_URI=http://localhost:8000/auth/wechat/callback
REVID_WECHAT_MOCK_ENABLED=true

# === Admin ===
REVID_DEV_ADMIN_KEY=dev-admin-key

# === Storage ===
REVID_STORAGE_BACKEND=local
REVID_STORAGE_LOCAL_ROOT=./storage
REVID_STORAGE_S3_BUCKET=
REVID_STORAGE_S3_ENDPOINT=
REVID_STORAGE_S3_REGION=us-east-1
