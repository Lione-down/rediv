{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revid.local/schemas/t5-096-official-canvas-scenario-manifest.schema.json",
  "title": "T5-096 official Canvas three-axis scenario manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "collected_at",
    "audit_status",
    "official_authority",
    "clean_room",
    "targets",
    "status_vocabulary",
    "required_scenario_fields",
    "evidence_sources",
    "scenarios",
    "completion_rule"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "task_id": { "const": "T5-096" },
    "collected_at": { "type": "string", "format": "date" },
    "audit_status": { "enum": ["BLOCKED", "IN_PROGRESS", "COMPLETE"] },
    "official_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "source_url", "observed_at", "version_clue", "access_status", "release_condition"],
      "properties": {
        "surface": { "const": "latest official authenticated LibTV Canvas" },
        "source_url": { "type": ["string", "null"] },
        "observed_at": { "type": ["string", "null"], "format": "date-time" },
        "version_clue": { "type": ["string", "null"] },
        "access_status": { "enum": ["browser_control_unavailable", "authenticated", "authentication_required"] },
        "release_condition": { "type": "string", "minLength": 1 }
      }
    },
    "clean_room": { "type": "object" },
    "targets": { "type": "object" },
    "status_vocabulary": { "type": "object" },
    "required_scenario_fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "evidence_sources": { "type": "array", "items": { "type": "object" } },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "surface",
          "source_url",
          "observed_at",
          "version_clue",
          "viewport",
          "zoom_percent",
          "precondition",
          "action_trace",
          "visible_result",
          "geometry",
          "focus_trace",
          "motion",
          "reference_file",
          "confidence",
          "visual_status",
          "functional_status",
          "interaction_status",
          "revid_extension_status"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$" },
          "surface": { "type": "string", "minLength": 1 },
          "source_url": { "type": "string", "format": "uri" },
          "observed_at": { "type": "string", "format": "date-time" },
          "version_clue": { "type": "string", "minLength": 1 },
          "viewport": { "enum": ["1440x900", "1366x768", "920x900", "1662x1138", "1440x900 / 1366x768 / 920x900"] },
          "zoom_percent": { "enum": [17, 28, 36, 39, 100, 200, 207] },
          "precondition": { "type": "string", "minLength": 1 },
          "action_trace": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "visible_result": { "type": "string", "minLength": 1 },
          "geometry": { "type": "object", "minProperties": 1 },
          "focus_trace": { "type": "array", "items": { "type": "string" } },
          "motion": { "type": "object", "minProperties": 1 },
          "reference_file": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "format": { "enum": ["JPEG", "PNG"] },
              "height": { "type": "integer", "minimum": 1 },
              "path": { "type": "string", "pattern": "^(output/t5-096/|ai/evidence/t5-096/)" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "width": { "type": "integer", "minimum": 1 }
            }
          },
          "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
          "visual_status": { "enum": ["PENDING", "MATCHED", "MISMATCH"] },
          "functional_status": { "enum": ["PENDING", "MATCHED", "MISMATCH"] },
          "interaction_status": { "enum": ["PENDING", "MATCHED", "MISMATCH"] },
          "revid_extension_status": { "enum": ["PENDING", "NOT_APPLICABLE", "EXTENSION_PRESERVED", "REGRESSION"] },
          "excluded_surface_ids": {
            "type": "array",
            "items": { "enum": ["official_director_console"] },
            "uniqueItems": true
          }
        }
      }
    },
    "completion_rule": { "type": "string", "minLength": 1 }
  }
}
