# === Database ===
REVID_DB_HOST=localhost
REVID_DB_PORT=3306
REVID_DB_NAME=revid_db
REVID_DB_USER=root
REVID_DB_PASSWORD=your_db_password

# === Agnes AI API ===
REVID_AGNES_API_KEY=your-agnes-api-key-here
REVID_AGNES_BASE_URL=https://apihub.agnes-ai.com

# === Agnes Models ===
REVID_AGNES_MODEL_TEXT=agnes-2.0-flash
REVID_AGNES_MODEL_IMAGE=agnes-image-2.1-flash
REVID_AGNES_MODEL_VIDEO=agnes-video-v2.0

# === WeChat OAuth ===
REVID_WECHAT_APP_ID=
REVID_WECHAT_APP_SECRET=
REVID_WECHAT_REDIRECT_URI=http://localhost:8000/auth/wechat/callback
REVID_WECHAT_MOCK_ENABLED=true

# === JWT ===
REVID_JWT_SECRET=change-this-secret-in-production

# === Admin ===
REVID_DEV_ADMIN_KEY=dev-admin-key

# === CORS ===
REVID_CORS_ORIGINS=["http://localhost:5173","http://localhost:9099"]

# === Storage ===
REVID_STORAGE_BACKEND=local
REVID_STORAGE_LOCAL_ROOT=./storage
REVID_ASSET_UPLOAD_MAX_BYTES=104857600
REVID_ASSET_UPLOAD_USER_QUOTA_BYTES=5368709120
REVID_ASSET_UPLOAD_MIN_FREE_BYTES=536870912
REVID_ASSET_UPLOAD_MAX_ACTIVE_RESERVATIONS=64
REVID_ASSET_UPLOAD_MAX_ACTIVE_RESERVATIONS_PER_USER=2
REVID_ASSET_UPLOAD_RESERVATION_SCAN_LIMIT=256
REVID_ASSET_UPLOAD_USER_FILE_COUNT_LIMIT=10000
REVID_ASSET_UPLOAD_VALIDATION_CONCURRENCY=4
REVID_ASSET_UPLOAD_IDLE_TIMEOUT_SECONDS=30
REVID_ASSET_UPLOAD_TOTAL_TIMEOUT_SECONDS=600
REVID_STORAGE_S3_BUCKET=
REVID_STORAGE_S3_ENDPOINT=
REVID_STORAGE_S3_REGION=us-east-1
